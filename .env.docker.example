# Copy this file to .env.docker and fill in your values.
# The agent container reads this file at runtime via env_file in docker-compose.yml.

# ── Required: LLM (use one of the two below) ──────────────────────────────────
# Option A — OpenAI directly
OPENAI_API_KEY=sk-...
# Option B — OpenRouter (supports many models; takes priority over OPENAI_API_KEY)
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Required: Web search ───────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Optional: Tako MCP data source ────────────────────────────────────────────
# TAKO_API_TOKEN=
# TAKO_MCP_URL=

# ── Optional: override LangGraph Cloud deployment ─────────────────────────────
# LGC_DEPLOYMENT_URL=
