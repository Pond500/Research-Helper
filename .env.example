# Research Canvas - Environment Variables

# Required: OpenAI API Key for LLM
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Optional: route the default model through OpenRouter instead of OpenAI directly
# OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the chat model (defaults to gpt-4o)
#   OPENROUTER_MODEL — slug used when OPENROUTER_API_KEY is set (default: openai/gpt-4o)
#   OPENAI_MODEL     — model used when calling OpenAI directly (default: gpt-4o)
# OPENROUTER_MODEL=openai/gpt-4o
# OPENAI_MODEL=gpt-4o

# Optional: cap retained in-memory checkpointer threads (default: 200)
# CHECKPOINT_MAX_THREADS=200

# Required: Tavily API Key for web search
# Get from: https://tavily.com
TAVILY_API_KEY=your-tavily-key

# Optional: Tako API token for data source
# Get from: https://tako.com/account
TAKO_API_TOKEN=your_api_token_here

# Optional: URL of Tako's MCP server
TAKO_MCP_URL=https://mcp.tako.com

# Optional: URL of Tako's main API
TAKO_URL=https://tako.com
